# Production install profile for Pterodactyl hosts (Wispbyte, Bloom, …).
#
# WHY THIS FILE EXISTS: the panel runs a bare `npm install` on every boot. With
# devDependencies included, node_modules is 124MB instead of 47MB and the
# container hits ENOSPC — mongodb-memory-server alone tries to download a full
# MongoDB binary at install time.
#
# Tests and linting still work locally: run `npm install --include=dev`.
omit=dev

# The host has a small disk and no need for the audit/funding round-trips.
audit=false
fund=false
