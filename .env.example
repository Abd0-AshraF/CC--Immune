# ============================================================================
#  CC IMMUNE — ENVIRONMENT CONFIGURATION
#  Copy this file to `.env` and fill in the values.
#  On Wispbyte / Pterodactyl panels: set these in the "Startup" tab instead.
#  NEVER commit your real .env file. NEVER share your token.
# ============================================================================

# ---------------------------------------------------------------------------
#  1. DISCORD (REQUIRED)
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=
# Application (Client) ID from the "General Information" page
CLIENT_ID=
# Optional: a test guild ID. When set, commands deploy instantly to this guild
# only (great for development). Leave empty to deploy globally (~1h propagation).
DEV_GUILD_ID=
# Comma-separated Discord user IDs with full owner access
# Set to an OLD DEV_GUILD_ID after moving to global commands, so leftover
# guild commands get cleared on the next deploy.
PRUNE_GUILD_ID=

OWNER_IDS=
# Comma-separated Discord user IDs with developer access (subset of owner)
DEVELOPER_IDS=

# ---------------------------------------------------------------------------
#  2. DATABASE (REQUIRED)
# ---------------------------------------------------------------------------
# MongoDB connection string. Free tier: https://cloud.mongodb.com (M0)
# IMPORTANT for Wispbyte: whitelist 0.0.0.0/0 in Atlas -> Network Access
MONGO_URI=mongodb://127.0.0.1:27017/ccimmune
MONGO_DB_NAME=ccimmune
# Max connection pool size. Keep low (5-10) on small hosts.
MONGO_POOL_SIZE=10

# Optional Redis for distributed cache + cooldowns.
# Leave EMPTY to automatically use the in-memory LRU fallback (Wispbyte-friendly).
REDIS_URL=
# cache driver: auto | redis | memory
CACHE_DRIVER=auto

# ---------------------------------------------------------------------------
#  3. RUNTIME
# ---------------------------------------------------------------------------
# production | development
NODE_ENV=production
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Write logs to ./logs/*.log in addition to the console
LOG_TO_FILE=false
# Default language when nothing else is set: en | ar
DEFAULT_LOCALE=en
# IANA timezone used by schedulers and prayer times
TIMEZONE=Africa/Cairo
# Enable sharding. Keep FALSE on Wispbyte / small hosts.
SHARDING_ENABLED=false

# ---------------------------------------------------------------------------
#  4. COMMANDS (slash + prefix)
# ---------------------------------------------------------------------------
SLASH_COMMANDS_ENABLED=true
# Prefix commands REQUIRE the privileged "Message Content Intent".
# Enable it at: Dev Portal -> Bot -> Privileged Gateway Intents.
# If the intent is off, the bot still boots and falls back to mention-prefix.
PREFIX_COMMANDS_ENABLED=true
DEFAULT_PREFIX=!
# Allow "@CC Immune ping" as a prefix (does NOT need the privileged intent)
MENTION_AS_PREFIX=true
# Allow commands in direct messages
DM_COMMANDS_ENABLED=false
# Hide commands of disabled modules from the Discord command list
HIDE_DISABLED_COMMANDS=false

# Run seed + command deployment automatically on startup (for panels with no
# usable console). Safe to leave on: each step is fingerprinted and only runs
# when something actually changed. Set to false to manage it manually.
AUTO_BOOTSTRAP=true

# ---------------------------------------------------------------------------
#  5. DIAGNOSTICS (see /doctor and `npm run doctor`)
# ---------------------------------------------------------------------------
DEBUG_MODE=false
# When true, ANY failed preflight check stops the boot (default: only fatal ones)
PREFLIGHT_STRICT=false
# Discord webhook URL that receives high/fatal error alerts
ERROR_WEBHOOK_URL=
# Internal HTTP server for /health, /metrics, /stats
API_SERVER_ENABLED=true
API_PORT=3000
API_HOST=0.0.0.0
# Secret required by protected endpoints (e.g. POST /reload)
API_SECRET=

# ---------------------------------------------------------------------------
#  6. MLBB DATA API
#  Community API (unofficial). Not affiliated with or endorsed by Moonton.
# ---------------------------------------------------------------------------
# PRIMARY: Moonton's own content API — the one the official website calls.
# No API key, no rate limit, no middleman. Verified live.
MOONTON_API_BASE=https://api.gms.moontontech.com
MLBB_PREFER_DIRECT=true

# OPTIONAL community wrapper. Leave EMPTY: both hosts the upstream project
# documents no longer exist (mlbb.rone.dev has no DNS record; the mirror 404s).
# Moonton direct covers heroes, stats and counters; items ship with the bot.
MLBB_API_BASE=
# High-volume mirror, used automatically if the primary fails
MLBB_API_MIRROR=https://openmlbb.fastapicloud.dev/api
MLBB_TIMEOUT_MS=15000
# Nightly re-pull of heroes + items so new patches appear without a redeploy
MLBB_AUTO_SYNC=true
# Cache time-to-live for hero/meta data, in seconds (default 6 hours)
MLBB_CACHE_TTL=21600
# Nightly meta sync (cron format)
MLBB_SYNC_CRON=0 4 * * *

# ---------------------------------------------------------------------------
#  7. AI PROVIDERS  (OpenRouter is the default — free & one key for all models)
#  Get a key: https://openrouter.ai/keys   (free models end with ":free")
#  Primary is tried first; on failure/quota the bot fails over to the fallback.
# ---------------------------------------------------------------------------
# openrouter | groq | openai
AI_PROVIDER=openrouter
AI_FALLBACK_PROVIDER=none

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Tried in order when the model above is rate-limited or retired
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-chat-v3-0324:free,google/gemma-3-27b-it:free,qwen/qwen-2.5-72b-instruct:free
# Shown on the OpenRouter app leaderboard (optional)
OPENROUTER_SITE_URL=https://github.com/cc-immune/bot
OPENROUTER_APP_NAME=CC Immune

# Optional secondary providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Per-user daily token budget for AI features
AI_DAILY_TOKEN_QUOTA=50000
AI_MAX_OUTPUT_TOKENS=1200
AI_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
#  8. AI MEMORY LAYER
# ---------------------------------------------------------------------------
AI_MEMORY_ENABLED=true
# Use MongoDB Atlas Vector Search. If false, a local cosine index is used.
ATLAS_VECTOR=false
EMBEDDING_MODEL=text-embedding-3-small
MEMORY_MAX_FACTS_PER_USER=200
MEMORY_MAX_VECTORS_PER_USER=500
MEMORY_TTL_DAYS=180
# Tokens kept in a live session before it gets summarized
MEMORY_SESSION_TOKEN_BUDGET=3000

# ---------------------------------------------------------------------------
#  9. AUDIO (Lavalink v4)
#  Lavalink must run as a SEPARATE service. It cannot run on Wispbyte free.
#  Leave LAVALINK_HOST empty to disable music gracefully.
# ---------------------------------------------------------------------------
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_NAME=main
# Leave the voice channel after N seconds of inactivity
MUSIC_IDLE_TIMEOUT=300
MUSIC_MAX_QUEUE_SIZE=500
MUSIC_DEFAULT_VOLUME=60

# ---------------------------------------------------------------------------
#  10. QURAN RADIO + PRAYER TIMES
#  Comma-separated stream mirrors, tried in order with automatic failover.
# ---------------------------------------------------------------------------
QURAN_STREAMS=https://n0a.radiojar.com/8s5u5tpdtwzuv,https://stream.radiojar.com/8s5u5tpdtwzuv,http://live.mp3quran.net:9702/,https://qurango.net/radio/tarateel
QURAN_RECITERS_API=https://mp3quran.net/api/v3
PRAYER_API_BASE=https://api.aladhan.com/v1
PRAYER_DEFAULT_CITY=Cairo
PRAYER_DEFAULT_COUNTRY=Egypt
# Aladhan calculation method (5 = Egyptian General Authority of Survey)
PRAYER_METHOD=5

# ---------------------------------------------------------------------------
#  11. MODULE KILL-SWITCHES (see §3.6)
#  Set any to false to permanently exclude that module on this host.
#  Runtime toggling is done with /module — these are the build-level gates.
# ---------------------------------------------------------------------------
MODULE_WELCOME=true
MODULE_VERIFICATION=true
MODULE_AUTOROLE=true
MODULE_MODERATION=true
MODULE_AUTOMOD=true
MODULE_LOGS=true
MODULE_TICKETS=true
MODULE_SUGGESTIONS=true
MODULE_POLLS=true
MODULE_GIVEAWAYS=true
MODULE_REACTIONROLES=true
MODULE_ANNOUNCEMENTS=true
MODULE_LEVELING=true
MODULE_ECONOMY=true
MODULE_SHOP=true
MODULE_LEADERBOARD=true
MODULE_MLBB_HEROES=true
MODULE_MLBB_DRAFT=true
MODULE_MLBB_TIERLIST=true
MODULE_MLBB_PLAYERS=true
MODULE_MLBB_TOURNAMENTS=true
MODULE_MLBB_SCRIMS=true
MODULE_MLBB_NEWS=true
MODULE_AI_COACH=true
MODULE_AI_MEMORY=true
MODULE_AI_TRANSLATION=true
MODULE_MUSIC=true
MODULE_QURAN=true
MODULE_PRAYER=true

# ---------------------------------------------------------------------------
#  12. BRANDING / LINKS
#  Shown on the landing page. If BOT_INVITE_URL is blank it is derived from
#  CLIENT_ID automatically, so the invite button is never dead.
# ---------------------------------------------------------------------------
BOT_INVITE_URL=
# Defaults to the CC Immune community server; set this to point members at
# your own server instead.
SUPPORT_SERVER_URL=https://discord.gg/zpsu2GYDcK
WEBSITE_URL=
DOCS_URL=

# ---------------------------------------------------------------------------
#  13. LANDING WEBSITE
#  Served at "/" by the same HTTP server as /health and /stats, so it needs no
#  extra port. Requires API_SERVER_ENABLED=true.
# ---------------------------------------------------------------------------
WEBSITE_ENABLED=true
# Which language the page opens in before the visitor toggles: ar | en
WEBSITE_DEFAULT_LANG=ar

# ---------------------------------------------------------------------------
#  14. WEB DASHBOARD
#  Served at "/dashboard" by the same HTTP server as the landing page, so it
#  needs no extra port and no separate hosting.
#
#  LOGIN: run /dashboard in Discord and the bot DMs you a single-use link that
#  is valid for ten minutes. That works on ANY host, including plain http.
# ---------------------------------------------------------------------------
DASHBOARD_ENABLED=true

# Needed so the bot can build a clickable link — it cannot discover its own
# public address from inside a container. Example: http://node-01.host.com:25591
WEBSITE_URL=

# --- optional: "Log in with Discord" button --------------------------------
# Discord rejects any redirect_uri that is not https (localhost excepted), so
# the OAuth button only appears when this is an https origin. Leave both blank
# to use magic links only.
#
# A free Cloudflare Quick Tunnel is NOT suitable here: its hostname changes on
# every restart and Discord matches redirect URIs exactly, so you would have to
# re-register the URL after each restart. Use a real domain for OAuth.
#
# Also add "<origin>/dashboard/callback" under
# Developer Portal -> OAuth2 -> Redirects.
DASHBOARD_PUBLIC_URL=
CLIENT_SECRET=

# ---------------------------------------------------------------------------
#  15. DISCORD DOMAIN VERIFICATION
#  Links this domain to your Discord profile:
#    Discord -> Settings -> Connections -> Domain -> Verify using HTTPS
#
#  Paste the "Content" value (the dh=... token). The "dh=" prefix is optional;
#  the bot serves it verbatim at /.well-known/discord.
# ---------------------------------------------------------------------------
DISCORD_DOMAIN_VERIFICATION=
